{
  "$schema": "https://opencode.ai/config.json",
  // Multi-agent architecture for the bleak-node front-end project.
  // Roles: main (orchestrator), concept (interactive), devops, architect,
  // design, planner, worker, tester. See .opencode/agents/*.md
  "default_agent": "main",
  // Shared project artifacts: every agent sees these once they exist.
  "instructions": [
    "docs/Concept.md",
    "docs/ARCHITECTURE.md",
    "docs/TZ.md"
  ],
  "permissions": [
    // The backend is read-only for this project.
    { "action": "edit", "resource": "/mount/bleak-node/**", "effect": "deny" },
    { "action": "read", "resource": "/mount/bleak-node/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/mount/bleak-node/**", "effect": "allow" },
    // Git policy guardrails (full policy lives in AGENTS.md).
    { "action": "shell", "resource": "git push * main", "effect": "deny" },
    { "action": "shell", "resource": "git push * main:*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout main*", "effect": "ask" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" }
  ]
}
