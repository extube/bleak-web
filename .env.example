# bleak-web environment (canonical, gitignored — commit template lives in .env.example)
GITHUB_USERNAME=extube
GITHUB_EMAIL=extube@proton.me

# --- bleak-node (read-only REST API) ----------------------------------------
# Default listen address of bleak-node (cmd/server: BLEAK_NODE_ADDR)
BLEAK_NODE_URL=http://localhost:8080

# --- thin helper service (invite-code mapping + QR) -------------------------
HELPER_PORT=8787
# Host token: only holders may create rooms via the helper (see ARCHITECTURE.md)
HELPER_HOST_TOKEN=dev-host-token-change-me
# SQLite file for the code -> room-address mapping (never bleak-node's DB)
HELPER_DB_PATH=data/helper.db
# Base URL used in invite links / QR payloads (join page of bleak-web)
INVITE_URL_BASE=http://localhost:5173/

# --- web SPA (Vite public env, read via import.meta.env) --------------------
# Empty = same-origin relative /api (dev proxy handles CORS; leave empty unless building for direct cross-origin access)
VITE_BLEAK_NODE_URL=
# Empty = same-origin relative /h (dev proxy)
VITE_HELPER_URL=
